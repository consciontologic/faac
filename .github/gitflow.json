{
  "production": "main",
  "integration": "develop",
  "branches": {
    "feature": {
      "from": "develop",
      "pull_request_into": "develop"
    },
    "bugfix": {
      "from": "develop",
      "pull_request_into": "develop"
    },
    "hotfix": {
      "from": "main",
      "pull_request_into": "main",
      "back_merge_into": "develop"
    },
    "release": {
      "from": "develop",
      "pull_request_into": "develop",
      "promote_from": "develop",
      "promote_into": "main",
      "back_merge_into": "develop"
    }
  },
  "agent_prefixes": [
    "codex",
    "claude",
    "copilot"
  ],
  "tag_prefix": "",
  "required_checks": [
    "Quality",
    "Package",
    "Container",
    "Security",
    "GitFlow"
  ],
  "required_approving_review_count": 0,
  "require_conversation_resolution": true,
  "require_pull_request": true,
  "force_push": false,
  "automation": {
    "enabled": false,
    "workflow": null,
    "task_submission": "explicit_maintainer_or_authorized_agent_request",
    "model_policy": ".github/copilot-model-policy.json",
    "back_merge": "manually_opened_pull_request",
    "note": "No controller, automatic paid tasks, review requests, repair loop or automatic merges."
  },
  "quality_lanes": [
    "any -> develop",
    "hotfix -> main"
  ],
  "promotion_validation": "GitFlow reuses successful merged develop PR evidence for the exact source and candidate merge tree",
  "checks_app_id": 15368,
  "check_workflows": {
    "Quality": ".github/workflows/ci.yml",
    "Package": ".github/workflows/ci.yml",
    "Container": ".github/workflows/container.yml",
    "Security": ".github/workflows/security.yml",
    "GitFlow": ".github/workflows/gitflow.yml"
  }
}
