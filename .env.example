# faac reads environment variables; it does not load .env files automatically.
# Prefer /connect's hidden prompt or a secret manager over shell-history literals.

# Optional provider credentials. Both providers require authentication for inference.
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# Groq also needs interactive /connect groq Free-plan/no-overage confirmation.

# Optional unlock passphrase for the encrypted vault; at least 12 characters.
# The passphrase is never stored by faac.
# FAAC_VAULT_PASSWORD=

# State, session, encrypted credentials, quota, and upstream cache directory.
# Defaults to ~/.local/share/faac; keep this outside repositories.
# FAAC_HOME=/absolute/private/path/faac

# Terminal accessibility and Unicode fallback.
# NO_COLOR=1
# FAAC_ASCII=1

# Explicit opt-in for npm run test:live; requires OPENROUTER_API_KEY.
# FAAC_LIVE_TEST=1
